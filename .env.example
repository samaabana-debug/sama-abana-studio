# Copier ce fichier en « .env » puis remplir les valeurs. Ne jamais publier le .env.

# Base de données : SQLite par défaut (fichier studio.db créé automatiquement)
DATABASE_URL=sqlite:///./studio.db
# PostgreSQL : DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/studio

# Adresse qui reçoit les demandes de devis
NOTIFY_EMAIL=Samaabana@gmail.com

# ---- Envoi des e-mails : choisir UNE des deux options ----

# Option 1 — Resend (recommandé en ligne : fonctionne même quand l'hébergeur bloque le SMTP)
# Créer un compte sur https://resend.com avec Samaabana@gmail.com, puis API Keys > Create API Key.
# Sans domaine vérifié, Resend n'envoie qu'à l'adresse du compte : suffisant pour recevoir les devis.
RESEND_API_KEY=
EMAIL_FROM=Motion Design by Sama Abana <onboarding@resend.dev>

# Option 2 — Gmail en SMTP (en local ou sur un VPS)
# 1. Activer la validation en deux étapes sur le compte Google
# 2. Créer un « mot de passe d'application » : https://myaccount.google.com/apppasswords
# 3. Coller ce mot de passe de 16 lettres ci-dessous (pas le mot de passe habituel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=Samaabana@gmail.com
SMTP_PASSWORD=
SMTP_FROM=Samaabana@gmail.com

# Envoyer un accusé de réception automatique au client (true / false)
SEND_CLIENT_CONFIRMATION=true

# Stockage des vidéos et photos ajoutées depuis /admin (Cloudinary, offre gratuite)
# Cloudinary > Settings > API Keys > « API environment variable » (avec la vraie clé et le vrai secret)
CLOUDINARY_URL=
# ou bien les trois valeurs séparées :
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Mot de passe de l'espace admin (/admin) et de l'API d'administration (voir README). Générer une valeur longue et aléatoire :
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Seulement si le site et l'API sont sur deux domaines différents (séparés par des virgules)
ALLOWED_ORIGINS=

# Nombre maximum de demandes de devis par heure et par connexion
QUOTE_RATE_LIMIT_PER_HOUR=5
